// Сформировать отчет в фоновом режиме
//
// Параметры:
//  АдресРезультата - Строка - адрес временного хранилища для размещения результата
//  АдресТоваров - Строка - адрес временного хранилища с данными товаров для анализа
//  ИДФормы - УникальныйИдентификатор - уникальный идентификатор формы
Функция СформироватьОтчетВФоне(ТаблицаТоваров, ИДФормы, ОбъектАнализа) Экспорт
	
		
	Результат = Новый Структура;
	Результат.Вставить("Результат", Новый ТабличныйДокумент);
	Результат.Вставить("ДанныеРасшифровки", Неопределено);
	Результат.Вставить("ОбъектАнализа", ОбъектАнализа);
	Результат.Вставить("ТаблицаТоваров", ТаблицаТоваров);
	Результат.Вставить("ИДФормы", ИДФормы);
	Результат.Вставить("ТекстОшибки", "");
		
	ОтчетОбъект = Отчеты.ПС_КонкурентнаяРазведка.Создать();
	ОтчетОбъект.ВывестиОтчет(Результат);
	
	Возврат Результат;
		
КонецФункции


Функция Аутентификация_N8N()

	Логин = Справочники.ПС_НастройкиРаспознавания.ПараметрРаспознавания("ЛогинN8N");
	Пароль = Справочники.ПС_НастройкиРаспознавания.ПараметрРаспознавания("ПарольN8N");

	Аутентификация = ПС_КоннекторHTTP.НоваяАутентификацияBasic(Логин, Пароль);
	    
	Возврат Аутентификация;
	
КонецФункции

Функция Заголовки_N8N()
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("x-client-id", "");
	
	Возврат Заголовки;
	
КонецФункции

Функция АдресМикросервиса(ИмяМикросервиса)
	
	Если Справочники.ПС_НастройкиРаспознавания.ПараметрРаспознавания("РежимТестированияСервиса") = Истина Тогда
		
		Возврат Справочники.ПС_НастройкиРаспознавания.ПараметрРаспознавания("АдресТестовогоКонтураСервиса");
		
	Иначе
	
		Если ИмяМикросервиса = "Распознавание" Тогда
			
			Возврат Справочники.ПС_НастройкиРаспознавания.ПараметрРаспознавания("АдресСервисаРаспознаванияДокументов");
			
		Иначе
			
			ВызватьИсключение "Сервис не поддерживается";
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

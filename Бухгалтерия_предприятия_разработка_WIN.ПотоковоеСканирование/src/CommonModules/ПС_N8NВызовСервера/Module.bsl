
#Область ПрограммныйИнтерфейс

Функция КонкурентнаяРазведкаN8N(МассивНоменклатуры, СписокСайтовДляАнализа, ДокументАнализа) Экспорт
	
	РазмерВыборки = 0;
	
	ДанныеКэша = ПолучитьОтветСервисаИзКэша(ДокументАнализа, РазмерВыборки);
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("РезультатПолучен", Ложь);
	РезультатОбработки.Вставить("Результат", Новый Массив);
	РезультатОбработки.Вставить("Комментарий", "");
	
	Если ЗначениеЗаполнено(ДанныеКэша) Тогда
	
		РезультатОбработки.Результат = ПС_ИндексацияФайловВызовСервера.JSONВСтруктуру(ДанныеКэша);
		РезультатОбработки.РезультатПолучен = Истина;	
		Возврат РезультатОбработки;		
		
	КонецЕсли;
	
	Если РазмерВыборки >= 100 Тогда
	
		РезультатОбработки.Комментарий = "Тестовый период окончен";
		Возврат РезультатОбработки;
		
	КонецЕсли;
	    
	// Определение нужного микросервиса и запроса к N8N
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("model", "competitors");
	СтруктураДанных.Вставить("competitors", СписокСайтовДляАнализа);
	СтруктураДанных.Вставить("variants", МассивНоменклатуры);
	
	ОтметитьСтатусВыполненияАнализаПоДокументу(ДокументАнализа, Истина);  
	
	Попытка

		Результат = ПС_КоннекторHTTP.PostJSON(АдресМикросервиса("Распознавание"), СтруктураДанных, 
		Новый Структура("Аутентификация,Заголовки,Таймаут", Аутентификация_N8N(), Заголовки_N8N(), 120));
	
		ЕстьДанные = Ложь;
		
		РезультатОбработки.Результат = ПС_ИндексацияФайловВызовСервера.JSONВСтруктуру(Результат["output"]);
		ЕстьДанные = Истина;
				
		Если ЕстьДанные Тогда
			

			РезультатОбработки.РезультатПолучен = Истина;
			
		КонецЕсли;
		
	Исключение
		
		РезультатОбработки.Комментарий = "Ошибка: " + ОписаниеОшибки();
		
	КонецПопытки;
	
	Если РезультатОбработки.РезультатПолучен Тогда
	
		ОтметитьСтатусВыполненияАнализаПоДокументу(ДокументАнализа, Ложь, ПС_ИндексацияФайловВызовСервера.СтруктураВJSON(РезультатОбработки.Результат)); 	
		
	Иначе
		
		ОтметитьСтатусВыполненияАнализаПоДокументу(ДокументАнализа, Ложь); 
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Процедура ОтметитьСтатусВыполненияАнализаПоДокументу(ДокументАнализа, СтатусВыполнения, РезультатРаботыСервиса = "")
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	НаборЗаписей = РегистрыСведений.ПС_КэшКонкурентнойРазведки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументАнализа.Установить(ДокументАнализа);
	НаборЗаписей.Отбор.ВерсияДанных.Установить(ДокументАнализа.ВерсияДанных);
	НаборЗаписей.Отбор.Период.Установить(Сегодня);
	НаборЗаписей.Прочитать();
	
	НаборЗаписей.Очистить();
		
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.ДокументАнализа = ДокументАнализа;
	НоваяЗапись.ВерсияДанных = ДокументАнализа.ВерсияДанных;
	НоваяЗапись.ТочноеВремя = ТекущаяДатаСеанса();
	НоваяЗапись.Период = Сегодня;
		
	НоваяЗапись.Выполняется = СтатусВыполнения;
	НоваяЗапись.ОтветСервиса = РезультатРаботыСервиса;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПолучитьОтветСервисаИзКэша(ДокументАнализа, РазмерВыборки = 0) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ПС_КэшКонкурентнойРазведки.ДокументАнализа) КАК КоличествоДокументовАнализа
	|ПОМЕСТИТЬ РазмерКэша
	|ИЗ
	|	РегистрСведений.ПС_КэшКонкурентнойРазведки КАК ПС_КэшКонкурентнойРазведки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПС_КэшКонкурентнойРазведки.ОтветСервиса КАК ОтветСервиса,
	|	РазмерКэша.КоличествоДокументовАнализа КАК КоличествоДокументовАнализаВКэше
	|ИЗ
	|	РегистрСведений.ПС_КэшКонкурентнойРазведки КАК ПС_КэшКонкурентнойРазведки,
	|	РазмерКэша КАК РазмерКэша
	|ГДЕ
	|	ПС_КэшКонкурентнойРазведки.ДокументАнализа = &ДокументАнализа
	|	И ПС_КэшКонкурентнойРазведки.ВерсияДанных = &ВерсияДанных
	|	И ПС_КэшКонкурентнойРазведки.Период = &Период
	|	И НЕ ПС_КэшКонкурентнойРазведки.Выполняется";
	
	Запрос.УстановитьПараметр("ДокументАнализа", ДокументАнализа);
	Запрос.УстановитьПараметр("ВерсияДанных", ДокументАнализа.ВерсияДанных);
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДатаСеанса()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	
	
	Выборка.Следующий();
	
	РазмерВыборки = Выборка.КоличествоДокументовАнализаВКэше;
	
	Возврат Выборка.ОтветСервиса;
	
КонецФункции

Функция ЕстьОчередьКонкурентногоАнализа() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПС_КэшКонкурентнойРазведки.ДокументАнализа КАК ОтветСервиса
	|ИЗ
	|	РегистрСведений.ПС_КэшКонкурентнойРазведки КАК ПС_КэшКонкурентнойРазведки
	|ГДЕ
	|	ПС_КэшКонкурентнойРазведки.Выполняется";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	РазмерВыборки = Выборка.Количество();
	
	Выборка.Следующий();
	Возврат Выборка.ОтветСервиса;
	
КонецФункции


// Выполняет распознавание документа N8N
// 
// Параметры:
//  ДДСкана - ДвоичныеДанные - двоичные данные скана
// 
// Возвращаемое значение:
//  Структура - результат распознавания:
//   * ОбработанУспешно - Булево - признак успешного выполнения распознавания
//   * Комментарий - Строка - комментарий в случае ошибки
//   * РаспознанныеДанные - Структура - данные распознанного документа
//   * КлючевыеРеквизиты - Структура - ключевые реквизиты распознанного документа
Функция РаспознатьДокументN8N(ДДСкана) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("ОбработанУспешно", Ложь);
	РезультатОбработки.Вставить("Комментарий", "");
	РезультатОбработки.Вставить("РаспознанныеДанные", Новый Структура);
	РезультатОбработки.Вставить("КлючевыеРеквизиты", Новый Структура);
	
	ДД_64 = Base64Строка(ДДСкана);
		    
	// Определение структуры
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("model", "mistral");
	    
	Сообщения = Новый Массив;
	    
		СообщениеСистемы = Новый Структура;
		СообщениеСистемы.Вставить("document_base64", ДД_64);
	
	Сообщения.Add(СообщениеСистемы);
	    
	СтруктураДанных.Вставить("messages", Сообщения);
	
	Попытка

		Результат = ПС_КоннекторHTTP.PostJSON(АдресМикросервиса("Распознавание"), СтруктураДанных, 
		Новый Структура("Аутентификация,Заголовки,Таймаут", Аутентификация_N8N(), Заголовки_N8N(), 120));
	
		КодВозврата 		= Строка(Результат["code"]);
		СервисноеСообщение 	= Строка(Результат["message"]);
		Совет 				= Строка(Результат["hint"]);
	
		ЕстьДанные = Ложь;

		Для каждого ТекЭлемент Из Результат["output"] Цикл
		
			РезультатОбработки.РаспознанныеДанные.Вставить(ТекЭлемент.Ключ, ТекЭлемент.Значение);	
			
			Если ПС_ИндексацияФайловВызовСервера.ЭтоКлючевойРеквизит(ТекЭлемент.Ключ) Тогда
			
				РезультатОбработки.КлючевыеРеквизиты.Вставить(ТекЭлемент.Ключ, ТекЭлемент.Значение);
				
			КонецЕсли;
			
			ЕстьДанные = Истина;
	
		КонецЦикла;	
		
		Если ЕстьДанные Тогда
		
			РезультатОбработки.ОбработанУспешно = Истина;
			
		КонецЕсли;
		
	Исключение
		
		РезультатОбработки.Комментарий = "Ошибка: " + ОписаниеОшибки() + " Код: " + КодВозврата + " Сообщение: " + СервисноеСообщение + " Совет N8N: " + Совет;
		
		Если ПС_ИндексацияФайловВызовСервера.ПолучитьНастройкуРаспознавания("РежимТестированияСервиса") = Истина Тогда
			
			ПС_ОбщегоНазначенияВызовСервера.СообщитьПользователю(РезультатОбработки.Комментарий);
			
		КонецЕсли;
		
	КонецПопытки;
	
	Возврат РезультатОбработки;
	
КонецФункции

// Функция выполняет поиск документа в сервисе N8N
//
// Параметры:
//  СтруктураКлючевыхРеквизитов - Структура - структура ключевых реквизитов
//  МассивВариантов - Массив из Строка
//
// Возвращаемое значение:
//  Структура - результат обработки
//	
Функция ПоискДокументаN8N(СтруктураКлючевыхРеквизитов, МассивВариантов) Экспорт
	
	РезультатОбработки = Новый Структура;
	РезультатОбработки.Вставить("ОбработанУспешно", Ложь);
	РезультатОбработки.Вставить("Результат", Новый Структура);
	РезультатОбработки.Вставить("Комментарий", "");
	    
	// Определение нужного микросервиса и запроса к N8N
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("model", "search");
	    
	Сообщения = Новый Массив;
		    
		СообщениеСистемы = Новый Структура;
		СообщениеСистемы.Вставить("request", СтруктураКлючевыхРеквизитов);
		СообщениеСистемы.Вставить("variants", МассивВариантов);
		Сообщения.Add(СообщениеСистемы);
	    
	СтруктураДанных.Вставить("messages", Сообщения);
	
	Попытка

		Результат = ПС_КоннекторHTTP.PostJSON(АдресМикросервиса("Распознавание"), СтруктураДанных, 
		Новый Структура("Аутентификация,Заголовки,Таймаут", Аутентификация_N8N(), Заголовки_N8N(), 120));
	
		ЕстьДанные = Ложь;

		Для каждого ТекЭлемент Из Результат["output"] Цикл
		
			РезультатОбработки.Результат.Вставить(ТекЭлемент.Ключ, ТекЭлемент.Значение);
			
			ЕстьДанные = Истина;
	
		КонецЦикла;	
		
		Если ЕстьДанные Тогда
			
			РезультатОбработки.Результат.accuracy = ПС_СлужебныеФункцииВызовСервера.Число2(РезультатОбработки.Результат.accuracy);
			РезультатОбработки.Результат.date = XMLЗначение(Тип("Дата"), СтруктураКлючевыхРеквизитов.date);
		
			РезультатОбработки.ОбработанУспешно = Истина;
			
		КонецЕсли;
		
	Исключение
		
		РезультатОбработки.Комментарий = "Ошибка: " + ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат РезультатОбработки;
	
КонецФункции

#КонецОбласти

